{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.attestto.org/cr/identity/v1/CedulaIdentidadCR.schema.json",
  "title": "Cedula de Identidad de Costa Rica",
  "description": "Credencial verificable de cedula de identidad costarricense. Auto-atestada por el ciudadano mediante escaneo OCR del documento fisico.",
  "type": "object",
  "required": ["credentialSubject", "evidence"],
  "properties": {
    "credentialSubject": {
      "type": "object",
      "required": ["id", "cedula", "fullName", "apellido1", "apellido2", "nombre", "dateOfBirth", "dateOfExpiry", "nationality", "sex", "photoHash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:",
          "description": "DID del ciudadano (vault DID)"
        },
        "cedula": {
          "type": "string",
          "pattern": "^\\d-\\d{4}-\\d{4}$",
          "description": "Numero de cedula de identidad (formato X-XXXX-XXXX)"
        },
        "fullName": {
          "type": "string",
          "description": "Nombre completo tal como aparece en la cedula"
        },
        "apellido1": {
          "type": "string",
          "description": "Primer apellido"
        },
        "apellido2": {
          "type": "string",
          "description": "Segundo apellido"
        },
        "nombre": {
          "type": "string",
          "description": "Nombre de pila"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Fecha de nacimiento"
        },
        "dateOfExpiry": {
          "type": "string",
          "format": "date",
          "description": "Fecha de vencimiento de la cedula"
        },
        "nationality": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Nacionalidad (ISO 3166-1 alpha-2)"
        },
        "sex": {
          "type": "string",
          "enum": ["M", "F"],
          "description": "Sexo segun documento"
        },
        "photoHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 hash de la foto del documento. No se almacena datos biometricos en la VC."
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "method", "ocrConfidence", "scannedAt"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["SelfAttestation"]
          },
          "method": {
            "type": "string",
            "enum": ["document-scan"],
            "description": "Metodo de captura del documento"
          },
          "ocrConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confianza del OCR (0.0 a 1.0)"
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del escaneo"
          }
        }
      }
    }
  }
}
