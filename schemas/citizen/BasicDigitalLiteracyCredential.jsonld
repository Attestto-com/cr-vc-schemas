{
  "@context": [
    "https://www.w3.org/2018/credentials/v1",
    "https://schemas.attestto.org/cr/identity/v1"
  ],
  "type": ["VerifiableCredential", "BasicDigitalLiteracyCredential"],
  "credentialSubject": {
    "id": "did:example:citizen-vault",
    "completedAt": "dateTime",
    "assessmentVersion": "string",
    "score": "number (0-100)"
  },
  "issuer": "did:web:attestto.com (system-issued)",
  "issuanceDate": "dateTime",
  "credentialSchema": {
    "id": "https://schemas.attestto.org/cr/identity/v1/BasicDigitalLiteracyCredential.schema.json",
    "type": "JsonSchema"
  }
}
