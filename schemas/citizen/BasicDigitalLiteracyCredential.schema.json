{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.attestto.org/cr/identity/v1/BasicDigitalLiteracyCredential.schema.json",
  "title": "Credencial de Alfabetizacion Digital Basica",
  "description": "Credencial verificable emitida por el sistema al completar la evaluacion de alfabetizacion digital durante el onboarding.",
  "type": "object",
  "required": ["credentialSubject"],
  "properties": {
    "credentialSubject": {
      "type": "object",
      "required": ["id", "completedAt", "assessmentVersion", "score"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:",
          "description": "DID del ciudadano (vault DID)"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora de completacion de la evaluacion"
        },
        "assessmentVersion": {
          "type": "string",
          "description": "Version del instrumento de evaluacion"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Puntaje obtenido (0-100)"
        }
      }
    }
  }
}
