{
  "@context": [
    "https://www.w3.org/2018/credentials/v1",
    "https://schemas.attestto.org/attestto/agreement/v1"
  ],
  "type": ["VerifiableCredential", "ConversationAgreementCredential"],
  "credentialSubject": {
    "id": "did:example:initiating-party",
    "agreementHash": "sha256:<hex>",
    "parties": [
      {
        "type": "AgreementPartyValue",
        "did": "did:example:party-a",
        "role": "string (e.g. buyer, seller, witness)",
        "agreedAt": "dateTime"
      },
      {
        "type": "AgreementPartyValue",
        "did": "did:example:party-b",
        "role": "string",
        "agreedAt": "dateTime"
      }
    ],
    "summary": "string (human-readable agreement summary)",
    "jurisdiction": "string (ISO 3166-1 alpha-2, e.g. CR)"
  },
  "issuer": "did:example:agreement-module",
  "issuanceDate": "dateTime",
  "credentialSchema": {
    "id": "https://schemas.attestto.org/cr/agreement/v1/ConversationAgreementCredential.schema.json",
    "type": "JsonSchema"
  },
  "credentialStatus": {
    "id": "https://status.attestto.org/credentials/agreement/1#0",
    "type": "StatusList2021Entry",
    "statusPurpose": "revocation",
    "statusListIndex": "integer",
    "statusListCredential": "https://status.attestto.org/credentials/agreement/1"
  }
}
