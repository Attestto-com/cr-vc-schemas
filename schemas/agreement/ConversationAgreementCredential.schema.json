{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.attestto.org/cr/agreement/v1/ConversationAgreementCredential.schema.json",
  "title": "Credencial de Acuerdo por Conversacion",
  "description": "Credencial verificable emitida cuando las partes alcanzan un acuerdo a traves del modulo de conversacion. Registra el hash del acuerdo, las partes involucradas, jurisdiccion, y resumen del acuerdo.",
  "type": "object",
  "required": ["credentialSubject"],
  "properties": {
    "credentialSubject": {
      "type": "object",
      "required": ["id", "agreementHash", "parties", "summary", "jurisdiction"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:",
          "description": "DID of the credential holder (initiating party)"
        },
        "agreementHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 hash of the full agreement content"
        },
        "parties": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["did", "role", "agreedAt"],
            "properties": {
              "did": {
                "type": "string",
                "pattern": "^did:",
                "description": "DID of the agreeing party"
              },
              "role": {
                "type": "string",
                "description": "Role of the party in the agreement (e.g. buyer, seller, witness)"
              },
              "agreedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when this party agreed"
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary of the agreement"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code of the governing jurisdiction"
        }
      }
    }
  }
}
